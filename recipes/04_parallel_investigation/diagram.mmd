flowchart LR
    Q([Multi-document question]) --> F{{Fan out: one reader per document}}
    F --> A[Reader: document A]
    F --> B[Reader: document B]
    F --> C[Reader: document C]
    A --> J{{Fan in}}
    B --> J
    C --> J
    J --> S{{Synthesize + compute}}
    S --> Out([Answer + FINAL_ANSWER])
