# Agentic FACETS runs against real OfficeQA data and a real model. Copy this file to `.env`
# (which is gitignored) and fill in the values below. Both the Python code and the dev tooling
# load `.env` from the repo root.

# --- Model: Databricks Unity AI Gateway (OpenAI-compatible surface) --------------------------
# Calls go to {DATABRICKS_HOST}/ai-gateway/mlflow/v1.

# Your workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# A Databricks token authorized for the AI Gateway (PAT for dev; OAuth SP for prod).
DATABRICKS_TOKEN=

# The Unity Catalog model-service name to call through the gateway, e.g.
#   system.ai.claude-sonnet-5
#   system.ai.gpt-5
FACETS_MODEL=system.ai.claude-sonnet-5

# --- Data: OfficeQA benchmark (gated on Hugging Face) ----------------------------------------

# A Hugging Face token (https://huggingface.co/settings/tokens) for an account that has been
# GRANTED ACCESS to the gated dataset at https://huggingface.co/datasets/databricks/officeqa
# (click "Agree and access repository" there first).
HF_TOKEN=
