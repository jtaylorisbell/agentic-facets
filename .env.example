# Databricks Foundation Model endpoints (OpenAI-compatible surface).
# Only needed to run recipes with `--live`; everything runs offline via the FakeModel by default.

# Your workspace URL, e.g. https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HOST=

# A Databricks token with "Can Query" on the serving endpoint (PAT for dev; OAuth SP for prod).
DATABRICKS_TOKEN=

# The serving-endpoint name to use as the model, e.g.
#   databricks-claude-sonnet-4-6
#   databricks-gpt-5
FACETS_MODEL=databricks-claude-sonnet-4-6
